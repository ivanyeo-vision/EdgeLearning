<Window x:Class="ModelTraining.Views.TeachWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tools="clr-namespace:ModelTraining.ToolLibrary"
        Title="Teach recipe" Width="1280" Height="800"
        WindowStartupLocation="CenterScreen" Background="#FF1E222A">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Background" Value="#FF262B36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF333947"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FF6B7280"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Check" TargetType="TextBlock">
            <Setter Property="Text" Value="&#x2713;"/>
            <Setter Property="Foreground" Value="#FF3DDC84"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Steps -->
        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="12">
            <StackPanel>
                <TextBlock Text="TEACH RECIPE" Foreground="#FF1E90FF" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                <TextBlock Text="BACKBONE FILE (in Assets)" Foreground="#FF9AA0AC" FontSize="11"/>
                <TextBox Text="{Binding BackboneFile, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                <TextBlock Text="BACKBONE NAME" Foreground="#FF9AA0AC" FontSize="11"/>
                <TextBox Text="{Binding BackboneName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,14"/>

                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Check}"
                               Visibility="{Binding HasReference, Converter={StaticResource B2V}}"/>
                    <Button Style="{StaticResource StepButton}" Content="1   Load reference image"
                            Command="{Binding LoadReferenceCommand}"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Check}"
                               Visibility="{Binding HasFiducial, Converter={StaticResource B2V}}"/>
                    <Button Style="{StaticResource StepButton}" Content="2   Set fiducial anchor"
                            Command="{Binding SetFiducialCommand}" IsEnabled="{Binding CanSetFiducial}"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Check}"
                               Visibility="{Binding HasSearch, Converter={StaticResource B2V}}"/>
                    <Button Style="{StaticResource StepButton}" Content="3   Draw search region (once)"
                            Command="{Binding DrawSearchCommand}" IsEnabled="{Binding CanDrawSearch}"/>
                </DockPanel>

                <Border BorderBrush="#FF333947" BorderThickness="1" Padding="8" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="COMPONENT NAME" Foreground="#FF9AA0AC" FontSize="11"/>
                        <TextBox Text="{Binding NewComponentName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Check}"
                                       Visibility="{Binding HasComponents, Converter={StaticResource B2V}}"/>
                            <Button Style="{StaticResource StepButton}" Content="4   Add component (repeat per type)"
                                    Command="{Binding AddComponentCommand}" IsEnabled="{Binding CanAddComponent}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding ComponentSummary}" Foreground="#FF9AA0AC" TextWrapping="Wrap" Margin="22,6,0,0"/>
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Check}"
                               Visibility="{Binding HasPassCrops, Converter={StaticResource B2V}}"/>
                    <Button Style="{StaticResource StepButton}" Content="5   Extract PASS components"
                            Command="{Binding ExtractPassCommand}" IsEnabled="{Binding CanExtract}"/>
                </DockPanel>

                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Check}"
                               Visibility="{Binding IsTaught, Converter={StaticResource B2V}}"/>
                    <Button Style="{StaticResource StepButton}" Content="6   Instant Teach + save .aoi"
                            Command="{Binding InstantTeachCommand}" IsEnabled="{Binding CanTeach}"/>
                </DockPanel>

                <TextBlock Text="Wheel = zoom, right-drag = pan, double-click = fit." Foreground="#FF6B7280"
                           FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Main Image Area -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,12,12,0">
            <!-- Restored custom control -->
            <tools:InspectionDisplay Source="{Binding ReferenceImage}"
                                     Regions="{Binding Overlay}"
                                     IsDrawMode="{Binding IsDrawMode}"
                                     ShowScores="False"
                                     RegionDrawn="Display_RegionDrawn"/>

            <Border Background="#CC000000" VerticalAlignment="Top" Padding="10,6"
                    Visibility="{Binding IsDrawMode, Converter={StaticResource B2V}}">
                <TextBlock Text="{Binding Hint}" Foreground="White" TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FF262B36" Padding="14,10">
            <TextBlock Text="{Binding Status}" Foreground="White" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>